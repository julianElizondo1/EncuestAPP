@implements IDisposable
@page "/registro"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@inject IAuthService AuthService
@inject ISesionService SesionService
@inject NavigationManager Navigation
@inject ILogger<Registro> Logger

<PageTitle>Crear cuenta | EncuestAPP</PageTitle>

<section class="auth-card" aria-labelledby="register-title">
    <header class="auth-card-header">
        <span class="auth-eyebrow">CREÁ TU CUENTA</span>
        <h1 id="register-title" class="auth-title">Sumate a EncuestAPP</h1>
        <p class="auth-subtitle">Creá tu cuenta para administrar encuestas y consultar resultados.</p>
    </header>

    @if (_error is not null)
    {
        <div class="auth-alert" role="alert">
            <svg class="auth-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 8v4m0 4h.01" /></svg>
            <div>
                <div>@_error</div>
                @if (_validationErrors.Count > 0)
                {
                    <ul>
                        @foreach (var validationError in _validationErrors)
                        {
                            <li>@validationError</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    <EditForm class="auth-form" Model="_solicitud" OnValidSubmit="RegistrarAsync">
        <DataAnnotationsValidator />
        <fieldset class="auth-fields" disabled="@_cargando">
        <div class="auth-field">
            <label for="name" class="auth-label">Nombre</label>
            <div class="auth-input-wrap">
                <svg class="auth-input-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
                <InputText id="name" class="auth-input" placeholder="Tu nombre" autocomplete="name" @bind-Value="_solicitud.Nombre" />
            </div>
            <ValidationMessage For="() => _solicitud.Nombre" class="auth-validation" />
        </div>
        <div class="auth-field">
            <label for="email" class="auth-label">Correo electrónico</label>
            <div class="auth-input-wrap">
                <svg class="auth-input-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
                <InputText id="email" type="email" class="auth-input" placeholder="nombre@ejemplo.com" autocomplete="email" @bind-Value="_solicitud.Email" />
            </div>
            <ValidationMessage For="() => _solicitud.Email" class="auth-validation" />
        </div>
        <div class="auth-field">
            <label for="password" class="auth-label">Contraseña</label>
            <div class="auth-input-wrap">
                <svg class="auth-input-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" /></svg>
                <InputText id="password" type="password" class="auth-input" placeholder="Creá una contraseña" autocomplete="new-password" @bind-Value="_solicitud.Contrasena" />
            </div>
            <ValidationMessage For="() => _solicitud.Contrasena" class="auth-validation" />
        </div>
        <div class="auth-field">
            <label for="password-confirmation" class="auth-label">Confirmar contraseña</label>
            <div class="auth-input-wrap">
                <svg class="auth-input-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12 4 4L19 6" /></svg>
                <InputText id="password-confirmation" type="password" class="auth-input" placeholder="Repetí tu contraseña" autocomplete="new-password" @bind-Value="_solicitud.ConfirmacionContrasena" />
            </div>
            <ValidationMessage For="() => _solicitud.ConfirmacionContrasena" class="auth-validation" />
        </div>
        <button type="submit" class="auth-submit" disabled="@_cargando">
            @if (_cargando)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>Creando cuenta...</span>
            }
            else
            {
                <span>Crear cuenta</span>
                <svg class="auth-submit-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
            }
        </button>
        </fieldset>
    </EditForm>

    <p class="auth-switch">
        ¿Ya tenés cuenta? <NavLink class="auth-link" href="/login">Volver al inicio de sesión</NavLink>
    </p>
</section>

@code {
    private readonly RegistroRequestDto _solicitud = new();
    private bool _cargando;
    private bool _descartado;
    private string? _error;
    private IReadOnlyList<string> _validationErrors = [];

    protected override void OnInitialized()
    {
        if (SesionService.EstaAutenticado)
        {
            if (!_descartado) Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task RegistrarAsync()
    {
        if (_cargando || _descartado) return;
        _cargando = true;
        _error = null;
        _validationErrors = [];

        try
        {
            await AuthService.RegistrarAsync(_solicitud);
            if (!_descartado) Navigation.NavigateTo(SesionService.EstaAutenticado ? "/" : "/login", replace: true);
        }
        catch (ApiClientException exception)
        {
            _error = exception.Message;
            _validationErrors = exception.ValidationErrors;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ocurrió un error inesperado al registrar la cuenta.");
            _error = "No se pudo completar el registro. Intentá nuevamente.";
        }
        finally
        {
            _cargando = false;
        }
    }
    public void Dispose() => _descartado = true;

}
