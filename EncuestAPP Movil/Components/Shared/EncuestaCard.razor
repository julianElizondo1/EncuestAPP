<article class="survey-summary-card card border-0 shadow-sm h-100">
    <div class="card-body d-flex flex-column p-3 p-sm-4">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <h2 class="flex-grow-1 h5 mb-0">@Encuesta.Titulo</h2>
            <EstadoEncuestaBadge Estado="Encuesta.Estado" />
        </div>
        @if (!string.IsNullOrWhiteSpace(Encuesta.Descripcion))
        {
            <p class="survey-summary-description text-secondary mb-3">@Encuesta.Descripcion</p>
        }
        <dl class="small mb-3">
            <dt class="text-secondary">Categoría</dt>
            <dd class="mb-2">@Encuesta.Categoria</dd>
            <dt class="text-secondary">Creada</dt>
            <dd class="mb-2">@FormatoFecha(Encuesta.FechaCreacion)</dd>
            @if (Encuesta.FechaPublicacion.HasValue)
            {
                <dt class="text-secondary">Publicada</dt>
                <dd class="mb-2">@FormatoFecha(Encuesta.FechaPublicacion.Value)</dd>
            }
            @if (Encuesta.FechaCierre.HasValue)
            {
                <dt class="text-secondary">Cerrada</dt>
                <dd class="mb-0">@FormatoFecha(Encuesta.FechaCierre.Value)</dd>
            }
        </dl>
        <div class="d-grid d-sm-flex gap-2 mt-auto">
            <NavLink class="btn btn-outline-primary btn-lg" href="@($"/encuestas/{Encuesta.Id}")">Ver detalle</NavLink>
            <NavLink class="btn btn-outline-secondary btn-lg" href="@($"/resultados?encuestaId={Encuesta.Id}")">Ver resultados</NavLink>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public EncuestaListaDto Encuesta { get; set; } = default!;

    private static string FormatoFecha(DateTime fecha) => fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
}
