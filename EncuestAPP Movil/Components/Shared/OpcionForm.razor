@implements IDisposable
<div class="border rounded-3 bg-light p-3 mt-2">
    <h5 class="h6 mb-3">@(Opcion is null ? "Nueva opción" : "Editar opción")</h5>
    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    <EditForm Model="_modelo" OnValidSubmit="GuardarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <fieldset class="app-fieldset" disabled="@_guardando">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label" for="@($"opcion-texto-{PreguntaId}-{Opcion?.Id ?? 0}")">Texto de la opción</label>
                <InputText id="@($"opcion-texto-{PreguntaId}-{Opcion?.Id ?? 0}")" class="form-control" maxlength="200" @bind-Value="_modelo.Texto" />
                <ValidationMessage For="@(() => _modelo.Texto)" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="@($"opcion-orden-{PreguntaId}-{Opcion?.Id ?? 0}")">Orden</label>
                <InputNumber id="@($"opcion-orden-{PreguntaId}-{Opcion?.Id ?? 0}")" class="form-control" min="1" @bind-Value="_modelo.Orden" />
                <ValidationMessage For="@(() => _modelo.Orden)" />
            </div>
            <div class="col-6 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1" disabled="@_guardando">
                    @if (_guardando)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    Guardar
                </button>
            </div>
        </div>
        <div class="mt-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnCancel" disabled="@_guardando">Cancelar</button>
        </div>
        </fieldset>
    </EditForm>
</div>

@code {
    [Inject]
    private IPreguntaService PreguntaService { get; set; } = default!;

    [Parameter]
    public int PreguntaId { get; set; }

    [Parameter]
    public OpcionEncuestaDto? Opcion { get; set; }

    [Parameter]
    public int OrdenInicial { get; set; } = 1;

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private CrearOpcionDto _modelo = new();
    private string? _error;
    private bool _guardando;
    private bool _descartado;
    private (int Pregunta, int Opcion)? _claveInicializada;

    protected override void OnParametersSet()
    {
        var clave = (PreguntaId, Opcion?.Id ?? 0);
        if (_claveInicializada == clave)
        {
            return;
        }

        _claveInicializada = clave;
        _modelo = Opcion is null
            ? new CrearOpcionDto { Orden = Math.Max(1, OrdenInicial) }
            : new CrearOpcionDto { Texto = Opcion.Texto, Orden = Opcion.Orden };
        _error = null;
    }

    private async Task GuardarAsync()
    {
        if (_guardando || _descartado) return;
        _guardando = true;
        _error = null;
        try
        {
            if (Opcion is null)
            {
                await PreguntaService.CrearOpcionAsync(PreguntaId, _modelo);
            }
            else
            {
                await PreguntaService.ActualizarOpcionAsync(Opcion.Id, new ActualizarOpcionDto
                {
                    Texto = _modelo.Texto,
                    Orden = _modelo.Orden
                });
            }
            if (!_descartado) await OnSaved.InvokeAsync();
            if (!_descartado) await OnCancel.InvokeAsync();
        }
        catch (ApiClientException exception)
        {
            _error = exception.MensajeConValidaciones;
            if (!_descartado) await OnSaved.InvokeAsync();
        }
        finally
        {
            _guardando = false;
        }
    }
    public void Dispose() => _descartado = true;

}
