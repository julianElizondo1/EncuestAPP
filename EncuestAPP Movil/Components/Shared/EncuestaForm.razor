@implements IDisposable
@inject IEncuestaService EncuestaService
@inject NavigationManager Navigation

@if (_cargandoDatos)
{
    <div class="d-flex align-items-center gap-2 py-4" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Cargando datos de la encuesta...</span>
    </div>
}
else if (!_datosListos)
{
    <div class="alert alert-danger" role="alert">
        <p class="mb-2">@_error</p>
        <button type="button" class="btn btn-outline-danger" @onclick="CargarDatosAsync">Reintentar</button>
    </div>
}
else if (!_formularioDisponible)
{
    <div class="alert alert-warning" role="alert">@_error</div>
    @if (EncuestaId.HasValue)
    {
        <NavLink class="btn btn-outline-secondary btn-lg" href="@($"/encuestas/{EncuestaId.Value}")">Volver al detalle</NavLink>
    }
    else
    {
        <NavLink class="btn btn-outline-secondary btn-lg" href="/encuestas">Volver al listado</NavLink>
    }
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">
            <div>@_error</div>
            @if (_erroresValidacion.Count > 0)
            {
                <ul class="mb-0 mt-2">
                    @foreach (var error in _erroresValidacion)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
        </div>
    }

    @if (_encuesta?.Estado == "Publicada")
    {
        <div class="alert alert-info" role="status">Los datos generales de una encuesta publicada solo se pueden modificar mientras no tenga participaciones.</div>
    }

    <EditForm Model="_formulario" OnValidSubmit="GuardarAsync">
        <DataAnnotationsValidator />
        <fieldset class="app-fieldset" disabled="@_guardando">
        <div class="mb-3">
            <label for="titulo-encuesta" class="form-label">Título</label>
            <InputText id="titulo-encuesta" class="form-control form-control-lg" maxlength="150" @bind-Value="_formulario.Titulo" disabled="@_guardando" />
            <ValidationMessage For="() => _formulario.Titulo" />
        </div>
        <div class="mb-3">
            <label for="descripcion-encuesta" class="form-label">Descripción</label>
            <InputTextArea id="descripcion-encuesta" class="form-control" rows="4" @bind-Value="_formulario.Descripcion" disabled="@_guardando" />
        </div>
        <div class="mb-3">
            <label for="categoria-encuesta" class="form-label">Categoría</label>
            <InputSelect id="categoria-encuesta" class="form-select form-select-lg" @bind-Value="_formulario.CategoriaEncuestaId" disabled="@_guardando">
                <option value="0">Seleccioná una categoría</option>
                @foreach (var categoria in _categorias)
                {
                    <option value="@categoria.Id">@categoria.Nombre</option>
                }
            </InputSelect>
            <ValidationMessage For="() => _formulario.CategoriaEncuestaId" />
        </div>
        <div class="form-check mb-3">
            <InputCheckbox id="encuesta-anonima" class="form-check-input" @bind-Value="_formulario.EsAnonima" disabled="@_guardando" />
            <label class="form-check-label" for="encuesta-anonima">Encuesta anónima</label>
        </div>
        <div class="form-check mb-4">
            <InputCheckbox id="una-respuesta-dispositivo" class="form-check-input" @bind-Value="_formulario.UnaRespuestaPorDispositivo" disabled="@_guardando" />
            <label class="form-check-label" for="una-respuesta-dispositivo">Una respuesta por dispositivo</label>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2">
            <button type="submit" class="btn btn-primary btn-lg" disabled="@_guardando">
                @if (_guardando)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <span>@(EncuestaId.HasValue ? "Guardar cambios" : "Crear encuesta")</span>
                }
            </button>
            <button type="button" class="btn btn-outline-secondary btn-lg" disabled="@_guardando" @onclick="Cancelar">Cancelar</button>
        </div>
        </fieldset>
    </EditForm>
}

@code {
    [Parameter]
    public int? EncuestaId { get; set; }

    private readonly CrearEncuestaDto _formulario = new();
    private IReadOnlyList<CatalogoDto> _categorias = [];
    private EncuestaDetalleDto? _encuesta;
    private IReadOnlyList<string> _erroresValidacion = [];
    private string? _error;
    private bool _cargandoDatos = true;
    private bool _datosListos;
    private bool _formularioDisponible;
    private bool _guardando;
    private bool _descartado;

    private bool PuedeEditar => _encuesta is not null && _encuesta.Estado is "Borrador" or "Publicada";

    protected override Task OnInitializedAsync() => CargarDatosAsync();

    private async Task CargarDatosAsync()
    {
        if (_descartado) return;
        _cargandoDatos = true;
        _datosListos = false;
        _formularioDisponible = false;
        _error = null;
        _erroresValidacion = [];
        try
        {
            _categorias = await EncuestaService.ObtenerCategoriasAsync();
            if (EncuestaId.HasValue)
            {
                _encuesta = await EncuestaService.ObtenerDetalleAsync(EncuestaId.Value);
                if (!PuedeEditar)
                {
                    _error = "Solo se pueden editar encuestas en borrador o publicadas.";
                }
                else
                {
                    _formulario.Titulo = _encuesta.Titulo;
                    _formulario.Descripcion = _encuesta.Descripcion;
                    _formulario.EsAnonima = _encuesta.EsAnonima;
                    _formulario.UnaRespuestaPorDispositivo = _encuesta.UnaRespuestaPorDispositivo;
                    var coincidencias = _categorias.Where(x => string.Equals(x.Nombre, _encuesta.Categoria, StringComparison.OrdinalIgnoreCase)).ToArray();
                    if (coincidencias.Length != 1)
                    {
                        _error = "No se pudo identificar la categoría actual en el catálogo. No se realizaron cambios.";
                    }
                    else
                    {
                        _formulario.CategoriaEncuestaId = coincidencias[0].Id;
                        _formularioDisponible = true;
                    }
                }
            }
            else
            {
                _formularioDisponible = true;
            }
            _datosListos = true;
        }
        catch (ApiClientException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _cargandoDatos = false;
        }
    }

    private async Task GuardarAsync()
    {
        if (_guardando || _descartado) return;
        _guardando = true;
        _error = null;
        _erroresValidacion = [];
        try
        {
            var id = EncuestaId;
            if (id.HasValue)
            {
                var solicitud = new ActualizarEncuestaDto
                {
                    Titulo = _formulario.Titulo,
                    Descripcion = _formulario.Descripcion,
                    CategoriaEncuestaId = _formulario.CategoriaEncuestaId,
                    EsAnonima = _formulario.EsAnonima,
                    UnaRespuestaPorDispositivo = _formulario.UnaRespuestaPorDispositivo
                };
                await EncuestaService.ActualizarAsync(id.Value, solicitud);
                if (!_descartado) Navigation.NavigateTo($"/encuestas?resultado={id.Value}&tipo=actualizada");
            }
            else
            {
                var creada = await EncuestaService.CrearAsync(_formulario);
                if (!_descartado) Navigation.NavigateTo($"/encuestas?resultado={creada.Id}&tipo=creada");
            }
        }
        catch (ApiClientException exception)
        {
            _error = exception.Message;
            _erroresValidacion = exception.ValidationErrors;
            if (EncuestaId.HasValue && exception.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var mensaje = _error;
                try
                {
                    _encuesta = await EncuestaService.ObtenerDetalleAsync(EncuestaId.Value);
                    _formularioDisponible = PuedeEditar;
                    if (!_formularioDisponible)
                    {
                        _error = $"{mensaje} El estado de la encuesta cambió y ya no permite editarla.";
                    }
                }
                catch (ApiClientException refreshException)
                {
                    _formularioDisponible = refreshException.StatusCode != System.Net.HttpStatusCode.NotFound;
                }
                if (_formularioDisponible)
                {
                    _error = mensaje;
                }
            }
        }
        finally
        {
            _guardando = false;
        }
    }
    private void Cancelar()
    {
        if (_guardando || _descartado) return;
        Navigation.NavigateTo(EncuestaId.HasValue ? $"/encuestas/{EncuestaId.Value}" : "/encuestas");
    }

    public void Dispose() => _descartado = true;

}
