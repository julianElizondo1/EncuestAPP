@inherits LayoutComponentBase

<main class="auth-shell">
    <section class="auth-frame">
        <aside class="auth-aside" aria-label="EncuestAPP">
            <a class="auth-brand" href="/">
                <span class="auth-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M7 4.5h10A1.5 1.5 0 0 1 18.5 6v12A1.5 1.5 0 0 1 17 19.5H7A1.5 1.5 0 0 1 5.5 18V6A1.5 1.5 0 0 1 7 4.5Z" />
                        <path d="M9 9h6M9 12.5h6M9 16h3" />
                    </svg>
                </span>
                <span>EncuestAPP</span>
            </a>
            <div class="auth-aside-content">
                <span class="auth-overline">ESCUCHAR PARA DECIDIR</span>
                <h2>Tus encuestas, en un solo lugar.</h2>
                <p>Creá encuestas, compartilas y transformá las respuestas en mejores decisiones.</p>
            </div>
            <div class="auth-aside-footer">
                <span class="auth-status-dot" aria-hidden="true"></span>
                <span>Creá, compartí y analizá.</span>
            </div>
        </aside>

        <section class="auth-main">
            <a class="auth-mobile-brand" href="/">
                <span class="auth-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M7 4.5h10A1.5 1.5 0 0 1 18.5 6v12A1.5 1.5 0 0 1 17 19.5H7A1.5 1.5 0 0 1 5.5 18V6A1.5 1.5 0 0 1 7 4.5Z" />
                        <path d="M9 9h6M9 12.5h6M9 16h3" />
                    </svg>
                </span>
                <span>EncuestAPP</span>
            </a>
            @Body
            <p class="auth-legal">EncuestAPP · Administración de encuestas.</p>
        </section>
    </section>
</main>
