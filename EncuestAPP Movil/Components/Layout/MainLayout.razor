@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@inject ISesionService SesionService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<MainLayout> Logger

<div class="admin-app">
    <header class="admin-header">
        <div class="d-flex align-items-center gap-2">
            <NavLink class="admin-brand" href="/">
                <span class="brand-mark" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" focusable="false">
                        <path d="M7 5.5h10a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 17 19.5H7A1.5 1.5 0 0 1 5.5 18V7A1.5 1.5 0 0 1 7 5.5Z" />
                        <path d="M9 10h6M9 13h6M9 16h3" />
                    </svg>
                </span>
                <span>EncuestAPP</span>
            </NavLink>
        </div>

        <div class="header-actions d-flex align-items-center gap-2 gap-md-3">
            @if (SesionService.Usuario is { } usuario)
            {
                <div class="text-end d-none d-sm-block">
                    <div class="fw-semibold small">@usuario.Nombre</div>
                    <div class="text-secondary small">@usuario.Email</div>
                </div>
            }
            <NavLink class="btn btn-outline-secondary btn-sm header-action" href="/perfil" aria-label="Perfil">
                <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 21a8 8 0 0 0-16 0M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>
                <span class="d-none d-sm-inline">Perfil</span>
            </NavLink>
            <button type="button" class="btn btn-outline-danger btn-sm header-action" aria-label="@(_cerrandoSesion ? "Cerrando sesión" : "Cerrar sesión")" @onclick="CerrarSesionAsync" disabled="@_cerrandoSesion">
                <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 17l5-5-5-5M15 12H3M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6" /></svg>
                <span class="d-none d-sm-inline">@(_cerrandoSesion ? "Cerrando..." : "Salir")</span>
            </button>
        </div>
    </header>

    <div class="admin-workspace">
        <main class="admin-content">
            @Body
        </main>
    </div>

    <nav class="mobile-bottom-nav" aria-label="Navegación inferior">
        <NavLink href="/" Match="NavLinkMatch.All" class="bottom-nav-link">
            <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m3 10 9-7 9 7M5 9v11h14V9M9 20v-6h6v6" /></svg>
            <span>Inicio</span>
        </NavLink>
        <NavLink href="/encuestas" class="bottom-nav-link">
            <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5h10A1.5 1.5 0 0 1 18.5 6v14H5.5V6A1.5 1.5 0 0 1 7 4.5Z" /><path d="M9 9h6M9 12.5h6M9 16h4" /></svg>
            <span>Mis encuestas</span>
        </NavLink>
        <NavLink href="/resultados" class="bottom-nav-link">
            <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20V10m6 10V4m6 16v-7m6 7H2" /></svg>
            <span>Resultados</span>
        </NavLink>
        <NavLink href="/perfil" class="bottom-nav-link">
            <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 21a8 8 0 0 0-16 0M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>
            <span>Perfil</span>
        </NavLink>
    </nav>
</div>

@code {
    private bool _descartado;
    private bool _cerrandoSesion;

    protected override void OnInitialized()
    {
        SesionService.EstadoSesionCambio += OnEstadoSesionCambio;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(() =>
        {
            if (_descartado) return;
            StateHasChanged();
        });

    private void OnEstadoSesionCambio() => _ = InvokeAsync(() =>
    {
        if (!_descartado) StateHasChanged();
    });

    private async Task CerrarSesionAsync()
    {
        if (_cerrandoSesion)
        {
            return;
        }

        _cerrandoSesion = true;
        try
        {
            await AuthService.CerrarSesionAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "No se pudo confirmar el cierre de sesión en la API; se cerró la sesión local.");
        }
        finally
        {
            _cerrandoSesion = false;
            Navigation.NavigateTo("/login", replace: true);
        }
    }

    public void Dispose()
    {
        _descartado = true;
        SesionService.EstadoSesionCambio -= OnEstadoSesionCambio;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
